
-- ==================================================
-- Project: E-commerce Marketing Analytics
-- Analysis: 02 - Data Quality Assessment
-- Purpose: Validate completeness of user IDs
-- ==================================================

WITH data_quality AS (
    SELECT
        COUNT(*) AS total_events,
        COUNTIF(user_id IS NOT NULL) AS events_with_user_id,
        COUNTIF(user_pseudo_id IS NOT NULL) AS events_with_pseudo_id,
        COUNTIF(user_pseudo_id IS NULL) AS missing_pseudo_id
    FROM
        `bigquery-public-data.ga4_obfuscated_sample_ecommerce.events_*`
)

SELECT
    *,
    ROUND(
        SAFE_DIVIDE(events_with_pseudo_id, total_events) * 100,
        2
    ) AS pseudo_id_completeness_pct
FROM data_quality;
